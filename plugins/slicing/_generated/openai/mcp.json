{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "helioadditive-slicing": {
      "extensions": {
        "com.openai": {
          "auth": {
            "baseScopes": [
              "slicing"
            ],
            "client": {
              "clientId": "openai-plugin",
              "mode": "provided",
              "tokenEndpointAuthMethod": "none"
            },
            "type": "oauth"
          }
        }
      },
      "type": "streamable-http",
      "url": "https://slicing.mcp.helioadditive.com/openai"
    }
  }
}
