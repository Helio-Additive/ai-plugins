schema {
  query: Query
  mutation: Mutation
}

enum GcodeStatus {
  INITIALIZING
  PARSING
  READY
  ERROR
  RESTRICTED
}

type MaterialBrand {
  id: ID!
  name: String!
  logoUrl: String
  description: String
  insertedAt: DateTime!
  updatedAt: DateTime!
}

type Mutation {
  """
  Create a new simulation.
  
  Checkpoint-based pipeline:
  1. Creates a DB record with `status = PENDING` and all checkpoints = `false`
  2. Triggers the **gcode-reader** K8s job (first pipeline stage)
  3. Returns the created Simulation immediately
  
  The pipeline then continues asynchronously via the internal API:
  gcode-reader → engine (dragon-vector-engine) → gcode-writer → `status = FINISHED`
  """
  createSimulation(input: CreateSimulationInput!): Simulation!
  """
  Create a new simulation (v2 with feature flags).
  
  Same checkpoint-based pipeline as `createSimulation`.
  """
  createSimulationV2(input: CreateSimulationInputV2!): Simulation!
  """
  Create a new optimization.
  
  Checkpoint-based pipeline:
  1. Creates a DB record with `status = PENDING` and all checkpoints = `false`
  2. Triggers the **gcode-reader** K8s job (first pipeline stage)
  3. Returns the created Optimization immediately
  
  The pipeline then continues asynchronously via the internal API:
  gcode-reader → engine (dragon-vector-engine) → gcode-writer → `status = FINISHED`
  """
  createOptimization(input: CreateOptimizationInput!): Optimization!
  """
  Create a new optimization (v2).
  
  Same checkpoint-based pipeline as `createOptimization`.
  """
  createOptimizationV2(input: CreateOptimizationInputV2!): Optimization!
  """
  Stop a running simulation.
  
  Allowed from any active status (PENDING, INITIALIZING, SIMULATING, ARCHIVING).
  Returns `true` if the simulation was stopped, `false` if it was already
  in a terminal state (Finished / Failed / Stopped) — matching the old API.
  """
  stopSimulation(id: ID!): Boolean!
  """
  Stop a running optimization.
  
  Returns `true` if stopped, `false` if already in a terminal state — matching the old API.
  """
  stopOptimization(id: ID!): Boolean!
  """
  Soft-delete an optimization.
  
  Sets `is_deleted = true`, clears optimized G-code S3 keys, and returns `true`.
  Matches the old API behaviour exactly.
  """
  deleteOptimization(id: ID!): Boolean!
  """
  Record feedback for a simulation.
  
  Verifies ownership, validates the rating, persists the feedback row,
  and returns the stored record.
  """
  addSimulationFeedback(input: SimulationFeedbackInput!): SimulationFeedback!
  """
  Record feedback for an optimization.
  
  Verifies ownership, validates the rating, persists the feedback row,
  and returns the stored record.
  """
  addOptimizationFeedback(input: OptimizationFeedbackInput!): OptimizationFeedback!
  """Create a single-material G-code."""
  createGcodeV2(input: CreateGcodeInputV2!): GcodeV2!
  """Create a multi-material G-code."""
  createGcodeV3(input: CreateGcodeInputV3!): GcodeV3!
  """Update a single-material G-code owned by the authenticated user."""
  updateGcodeV2(id: ID!, input: UpdateGcodeInputV2!): GcodeV2!
  """Delete a G-code owned by the authenticated user."""
  deleteGcode(id: ID!): Boolean!
  """
  Create a comment on a news article.
  
  Increments `n_comments` on the article by 1.
  """
  createNewsArticleComment(newsArticleId: ID!, commentMarkdown: String!): NewsArticleComment!
  """
  Create or update feedback for the current user on a news article.
  
  Only the `Option` fields that are `Some(...)` in `input` are applied;
  the rest are left unchanged.
  
  When `is_like` changes, `n_likes` on the article is incremented or
  decremented accordingly (clamped to >= 0).
  """
  updateNewsArticleFeedback(newsArticleId: ID!, input: NewsArticleFeedbackInput!): NewsArticleFeedback!
  """
  Record a deduplicated Store interaction for the authenticated user's
  verified experiment assignment.
  """
  recordStoreExperimentEvent(input: RecordStoreExperimentEventInput!): RecordStoreExperimentEventPayload!
  """
  Claim a one-time 14-day free trial with unlimited optimizations.
  
  Each user may only claim a free trial once. Use `freeTrialEligibility`
  to check whether the current user is eligible before calling this
  mutation.
  """
  claimFreeTrial(input: ClaimFreeTrialInput): FreeTrialClaim!
  """
  Create a Paddle billing portal session.
  
  Returns a short-lived URL that redirects the user to the Paddle
  customer portal where they can manage their subscription, payment
  method, and billing history.
  """
  createPaddlePortalSession: PaddlePortalSessionResponse!
  """
  Redeem a free trial code for the platform.
  
  A valid, unused `code` must be supplied. The code is marked as
  redeemed and associated with the authenticated user upon success.
  """
  redeemFreeTrialCode(input: RedeemFreeTrialCodeInput!): FreeTrialCode!
  """
  Redeem a subscription code for the platform.
  
  A valid, unused `code` must be supplied. The code is marked as
  redeemed and associated with the authenticated user upon success.
  """
  redeemSubscriptionCode(input: RedeemSubscriptionCodeInput!): SubscriptionCode!
  """
  Compare two existing G-code files without slicing or rewriting either input.
  """
  createGcodeTiming(input: CreateGcodeTimingInput!): GcodeTiming!
  """Rename display metadata only; never moves the stored object."""
  renameUploadedFile(id: ID!, name: String!): UploadedFile!
  """Rename a slice without dispatching work or modifying its file or jobs."""
  renameSlice(id: ID!, name: String!): Slice!
  """Register a reusable upload. A file has one engine-independent probe."""
  createUploadedFile(input: CreateUploadedFileInput!): UploadedFile!
  """Inspect an uploaded model while retaining it for subsequent slicing."""
  createInputProbe(input: CreateInputProbeInput!): InputProbe!
  """Create and enqueue a slice for the authenticated user."""
  createSlice(input: CreateSliceInput!): Slice!
  """
  Update the authenticated user's feature flag settings.
  
  Deprecated — use `updateFeatureFlags` instead.
  """
  updateUser(input: UpdateUserInput!): User! @deprecated(reason: "Use updateFeatureFlags instead")
  """Update the authenticated user's feature flag settings."""
  updateFeatureFlags(input: UpdateFeatureFlags!): User!
  """
  Update the authenticated user's feature flag settings (V2).
  
  Extends `updateFeatureFlags` with support for the vertical support
  interface optimisation flag.
  """
  updateFeatureFlagsV2(input: UpdateFeatureFlagsV2!): User!
  """
  Update the authenticated user's feature flag settings (V3).
  
  Extends `updateFeatureFlagsV2` with support for the
  `enableOptimizationForLayersUnableToReachTarget` flag.
  """
  updateFeatureFlagsV3(input: UpdateFeatureFlagsV3!): User!
  """
  Create a new user account.
  
  This operation requires external orchestration (e.g. password hashing,
  email verification, Paddle customer provisioning) and is not yet
  implemented in this service.
  """
  createUser(input: CreateUserInput!): User!
  """Send an OTP to the authenticated user's requested replacement email."""
  sendUserEmailUpdateOtp(email: String!): SendOtpResponse!
  """Verify an email update OTP and update the authenticated user's email."""
  verifyUserEmailUpdateOtp(email: String!, otpCode: String!): VerifyUserEmailUpdateOtpResponse!
  """
  Send a one-time password (OTP) to the provided email address.
  
  Resolves the user by email first, falling back to the PAT-owned placeholder
  user when appropriate, then persists a 10-minute OTP before sending the email.
  """
  sendOtp(email: String!, proceed: Boolean! = false): SendOtpResponse!
  """
  Verify the OTP sent to the provided email address.
  
  Links the incoming PAT to the resolved user, upgrading placeholder
  emails and transferring Dragon simulations and optimizations on
  existing-account relinks.
  """
  verifyOtp(email: String!, otpCode: String!): VerifyOtpResponse!
  """
  Submit a new suggestion for the L-FAM platform.
  
  Currently not yet implemented in this service.
  """
  createSuggestion(input: CreateSuggestionInput!): Suggestion!
  """Create a new personal access token for the authenticated user."""
  createPersonalAccessToken(name: String!, expirationDaysDelta: Int!): CreatePatTokenResponse!
  """
  Create an anonymous user + PAT for a slicer (BambuStudio / OrcaSlicer).
  
  This mutation requires no authentication — it is an open registration
  endpoint called by the router on behalf of the slicer.
  """
  createAnonymousPatToken(slicerType: AnonymousSlicerType!, isTestingFramework: Boolean!): AnonymousPatTokenResponse!
}

type OptimizationFeedback {
  id: ID!
  optimizationId: ID!
  rating: Float!
  comment: String
}

type PrintInfo {
  printOutcome: PrintOutcome!
  printOutcomeDescription: String!
  temperatureDirection: TemperatureDirection!
  temperatureDirectionDescription: String!
  caveats: [Caveat!]!
}

type GcodeCustomFloat {
  floatType: FloatType!
  """`true` when a client-supplied override constant is in effect."""
  isOverriden: Boolean!
  value: Float
}

enum CaveatType {
  OVERCOOLING_WITH_SEVERE_OVERHEATED_LAYERS
  OVERCOOLING_WITH_OVERHEATED_LAYERS
  OVERHEATING_WITH_SEVERE_OVERCOOLED_LAYERS
  OVERHEATING_WITH_OVERCOOLED_LAYERS
  OVERCOOLING_WITH_SEVERE_OVERCOOLED_LAYERS
  OVERCOOLING_WITH_OVERCOOLED_LAYERS
  OVERHEATING_WITH_SEVERE_OVERHEATED_LAYERS
  OVERHEATING_WITH_OVERHEATED_LAYERS
  OVERCOOLED_LAYERS
  SEVERE_OVERCOOLED_LAYERS
  OVERHEATED_LAYERS
  SEVERE_OVERHEATED_LAYERS
}

input UploadedFileFilter {
  name: SlicingNameFilter
  inputType: SliceInputType
}

enum GcodeRestriction {
  SIZE_TOO_LARGE
  WEIGHT_TOO_HEAVY
}

input SlicePresetOverridesInput {
  machineId: ID!
  processId: ID
  filamentIds: [ID!]
}

type UploadedFile {
  id: ID!
  """User-editable display name; independent of the stored object key."""
  name: String
  inputType: SliceInputType!
  inputKey: String!
  inputVersionId: String
  sha256: String!
  probeId: ID!
  insertedAt: DateTime!
  probe: InputProbe!
}

"""
Response returned after creating a new personal access token.
The `token` field contains the full plaintext token and is only ever
returned once — subsequent fetches will only expose the prefix.
"""
type CreatePatTokenResponse {
  name: String!
  token: String!
  expiresOn: DateTime!
  personalAccessToken: PersonalAccessToken!
}

input RecordStoreExperimentEventInput {
  visitId: ID!
  eventType: PublicStoreExperimentEventType!
  idempotencyKey: String!
  selectedTab: StoreExperimentPlanTab
  planKey: String
  paddlePriceId: String
  checkoutAttemptId: String
  trialEligible: Boolean
  locale: String
  pricingCountryCode: String
  pricingCountrySource: String
  currencyCode: String
  storeRelease: String
}

enum InputProbeStatus {
  PENDING
  SUCCEEDED
  FAILED
}

"""Legacy G-code type. Deprecated in favour of `GcodeV2`."""
type Gcode {
  id: ID!
  name: String!
  sizeKb: Float!
  height: Float!
  width: Float!
  depth: Float!
  platformTemperature: GcodeCustomFloat
  nozzleTemperatureMin: GcodeCustomFloat!
  nozzleTemperatureMax: GcodeCustomFloat!
  gcodeKey: String
  roadWidthMin: GcodeCustomFloat!
  roadWidthMax: GcodeCustomFloat!
  layerHeightMin: GcodeCustomFloat!
  layerHeightMax: GcodeCustomFloat!
  speedMin: GcodeCustomFloat!
  speedMax: GcodeCustomFloat!
  fanSpeedMin: GcodeCustomFloat!
  fanSpeedMax: GcodeCustomFloat!
  numberOfLayers: Int!
  slicer: Slicer!
  flowRatio: Float
  overrideGcodeParams: OverrideGcodeParams
  isSingleShell: Boolean!
  maxFlowRate: Float
  layerHeightMode: Float
  lineWidthMode: Float
  restrictions: [GcodeRestriction!]
  errors: [GcodeError!]
  printerId: ID!
  materialId: ID!
  insertedAt: DateTime!
  updatedAt: DateTime!
