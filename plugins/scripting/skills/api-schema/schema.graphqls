type OptimizationReductionStrategySettings {
  optimizationReductionStrategy: OptimizationReductionStrategy
  optimizationReductionAutolinearDoCriticality: Boolean
  optimizationReductionAutolinearDoFitness: Boolean
  optimizationReductionAutolinearDoInterpolation: Boolean
  optimizationReductionAutolinearCriticalityMaxNodesDensity: Float
  optimizationReductionAutolinearCriticalityThreshold: Float
  optimizationReductionAutolinearFitnessMaxNodesDensity: Float
  optimizationReductionAutolinearFitnessThreshold: Float
  optimizationReductionAutolinearInterpolationLevels: Int
  optimizationReductionLinearNodesLimit: Int
}

input FloatFilter {
  equalTo: Float
  notEqualTo: Float
  greaterThan: Float
  greaterThanOrEqualTo: Float
  lessThan: Float
  lessThanOrEqualTo: Float
  inList: [Float!]
  notInList: [Float!]
}

enum SlicerEngine {
  BAMBU
  ORCA
  SNAPMAKER
}

input SimulationSettingsInput {
  """
  Override warpage analysis for this run; omission preserves the user feature flag.
  """
  enableWarpingAnalysis: Boolean
  roomTemperature: Float
  airTemperatureAboveBuildPlate: Float
  temperatureStabilizationHeight: Float
  stabilizedAirTemperature: Float
  constantFanSpeed: Float
  constantPlatformTemperature: Float
  constantNozzleTemperature: Float
}

"""Input for the `redeemFreeTrialCode` mutation."""
input RedeemFreeTrialCodeInput {
  """Free trial code to redeem."""
  code: String!
}

"""
The desktop Simplify tool, headless. Exactly one of `level`, `ratio` or
`triangles` chooses how far to reduce.
"""
input SliceSimplifyInput {
  """Detail level of the dialog's slider; MEDIUM is the tool's default."""
  level: SimplifyLevel
  """Share of each part's triangles to remove, above 0 and below 100."""
  ratio: Float
  """
  Reduce each part to about this many triangles; a part at or under it is left as it is.
  """
  triangles: Int
  """Simplify only these 3MF object ids; omitted, every object."""
  objects: [Int!]
  """
  Carry painted colours, supports, seams and fuzzy skin onto the reduced mesh, as the
  desktop's "preserve painting" does. Off, the paint is cleared. The Snapmaker engine
  refuses it.
  """
  keepPaint: Boolean
}

"""Input for creating a multi-material G-code."""
input CreateGcodeInputV3 {
  name: String!
  description: String
  """Ordered materials; the first entry is the primary material."""
  materials: [GcodeMaterialInput!]!
  printerId: ID!
  """Object key returned after uploading the G-code file."""
  gcodeKey: String!
  isSingleShell: Boolean!
  isMultiMaterial: Boolean
  isMultiColor: Boolean
  """Override nozzle temperature in **Kelvin**."""
  overrideConstantNozzleTemperature: Float
  """Override layer height in **metres**."""
  overrideConstantLayerHeight: Float
  """Override line (road) width in **metres**."""
  overrideConstantLineWidth: Float
  """Override platform temperature in **Kelvin**."""
  overrideConstantPlatformTemperature: Float
}

"""A group of free trial codes associated with a subscription."""
type FreeTrialCodeGroup {
  id: ID!
  subscription: HelioSubscription!
  company: String!
  name: String!
  expirationDate: DateTime!
  quantityOfCodes: Int!
  isExpired: Boolean!
  insertedAt: DateTime!
  updatedAt: DateTime!
}

input CreateInputProbeInput {
  """
  Optional display name when registering a new file; does not rename an existing file.
  """
  name: String
  """
  Reuse a registered file, or supply inputType and inputKey to register an upload.
  """
  fileId: ID
  inputType: SliceInputType
  inputKey: String
  inputVersionId: String
}