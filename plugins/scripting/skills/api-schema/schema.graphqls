}

"""
Flat representation of residual strategy settings as stored on an Optimization record.
"""
type OptimizationResidualStrategySettings {
  optimizationResidualStrategy: OptimizationResidualStrategy
  optimizationResidualExponentialPenaltyLow: Float
  optimizationResidualExponentialPenaltyHigh: Float
}

enum OptimizationImprovement {
  LOW
  MEDIUM
  HIGH
}

enum Slicer {
  SIMPLIFY3D
  IDEAMAKER
  CURA
  BAMBU_LABS
  SUPERSLICER
  SLIC3R
  FUSION360
  BAAM
  MW
  CEAD_BAAM
  KRAUSS_MAFFEI
  PIOCREATE
  KUYING
  CEAD
  AI_BUILD
  AI_BUILD_GCODE
  AI_BUILD_SRC
  ADAONE
  PRUSA_SLICER
  SIGNIFY
  ORCA_SLICER
  CARACOL
  CREALITY_PRINT
  """An unrecognized slicer."""
  UNKNOWN
}

enum StoreExperimentSurface {
  STORE_PRICING
}

enum PrinterField {
  ID
  NAME
  BRAND_NAME
  ALTERNATIVE_NAME_BAMBUSTUDIO
  ALTERNATIVE_NAME_PRUSASLICER
  ALTERNATIVE_NAME_CURASLICER
  ALTERNATIVE_NAME_CREALITYPRINT
  BRAND_ID
  NOZZLE_DIAMETER
  IS_HEATED_BED
  IS_HEATED_CHAMBER
  IS_UNHEATED_CHAMBER
  MAX_EXTRUDER_FLOW_RATE
  MIN_EXTRUDER_FLOW_RATE
  MAX_HARDWARE_PRINT_SPEED
  MIN_HARDWARE_PRINT_SPEED
  MAX_HARDWARE_EXTRUSION_TEMP
  MIN_HARDWARE_EXTRUSION_TEMP
  CHAMBER_TYPE
  NUMBER_OF_NOZZLES
  N_NODES
}

type SimulationFeatureFlags {
  warpageAnalysisWasEnabled: Boolean!
  bridgeSpeedSmoothingWasEnabled: Boolean!
  aboveBridgeOptimizationWasEnabled: Boolean!
  fanSpeedOptimizationWasEnabled: Boolean!
  gpuWasUsed: Boolean!
  coreAssetsOnlyExportWasEnabled: Boolean!
  optimumNozzleTemperatureCapWasEnabled: Boolean!
  fanSpeedRampUpWasEnabled: Boolean!
  verticalSupportInterfacePreservationWasEnabled: Boolean!
  elementsActiveRangeWasEnabled: Boolean!
  optimizationForLayersUnableToReachTargetWasEnabled: Boolean!
}

type PresignedUrl {
  """MIME type inferred from the file extension."""
  mimeType: String!
  """Presigned PUT URL for direct S3 upload."""
  url: String!
  """S3 object key — pass back when referencing the uploaded file."""
  key: String!
}

input SimulationFeedbackInput {
  simulationId: ID!
  rating: Float!
  comment: String
}

input CreateGcodeTimingInput {
  """
  Stable UUID for this pair and context. Reuse unchanged after an ambiguous response.
  """
  identity: String!
  slicingEngine: SlicerEngine!
  """
  Required for Orca and Snapmaker from the original printer context. Omit for Bambu.
  """
  printerVendorBbl: Boolean
  original: GcodeTimingInputFile!
  optimized: GcodeTimingInputFile!
}

type SlicingIssue {
  code: String!
  field: String
  message: String!
  """
  Stable action identifier; clients can explain it in the user's language.
  """
  action: String!
}

"""Name comparisons use the shared database filtering semantics."""
input SlicingNameFilter {
  equalTo: String
  notEqualTo: String
  contains: String
  startsWith: String
  endsWith: String
}

"""Source of the free trial claim."""
enum TrialSource {
  """Trial claimed from the store/pricing page."""
  STORE
  """Trial claimed from the user dashboard."""
  DASHBOARD
}

"""Input for creating a new user account."""
input CreateUserInput {
  email: String
  firstName: String
  lastName: String
}

"""
Input for updating the authenticated user's feature flag settings (V3).
"""
input UpdateFeatureFlagsV3 {
  enableBridgeSpeedSmoothing: Boolean
  enableOptimizeAboveBridge: Boolean
  enableFanSpeedOptimization: Boolean
  enableAlwaysUseDragonGpu: Boolean
  enableApplyOptimumNozzleTemp: Boolean
  enableFanSpeedRampUp: Boolean
  enableKeepVerticalSupportInterface: Boolean
  enableOptimizationForLayersUnableToReachTarget: Boolean
  enableWarpageAnalysis: Boolean
}

enum TemperatureDirection {
  NONE
  OVERCOOLING
  OVERHEATING
}

input GcodeTimingInputFile {
  """
  Opaque upload key returned by get_presigned_url; never an artifact URL.
  """
  inputKey: String!
  inputVersionId: String
  """
  SHA-256 of the complete original bytes, verified when retaining the upload.
  """
  sha256: String!
}

enum HeatedChamberRequirement {
  NOT_REQUIRED
  OPTIONAL
  REQUIRED
}

type ReductionStrategySettings {
  strategy: OptimizationReductionStrategy!
  linearNodesLimit: Int!
  autolinearDoCriticality: Boolean!
  autolinearDoFitness: Boolean!
  autolinearDoInterpolation: Boolean!
  autolinearCriticalityMaxNodesDensity: Float!
  autolinearCriticalityThreshold: Float!
  autolinearFitnessMaxNodesDensity: Float!
  autolinearFitnessThreshold: Float!
  autolinearInterpolationLevels: Int!
}

type SimulationFeedback {
  id: ID!
  simulationId: ID!
  rating: Float!
  comment: String
}

type PaginatedMaterials {
  pages: Int!
  pageInfo: PageInfo!
  objects: [Material!]!
}

"""The authentication method used for a login record."""
enum LoginType {
  """User logs in using a username and password combination."""
  USERNAME_PASSWORD
  """User logs in using Auth0."""
  AUTH_0
}

type SliceArtifact {
  id: ID!
  kind: SliceArtifactKind!
  plateIndex: Int
  """Object size in bytes, encoded as a decimal 64-bit integer."""
  sizeBytes: String!
  sha256: String!
  state: SliceArtifactState!
  insertedAt: DateTime!
  updatedAt: DateTime!
  """Short-lived authenticated URL. Null while the object is unavailable."""
  downloadUrl: String
}

type Printer {
  id: ID!
  name: String!
  brand: PrinterBrand!
  alternativeNames: AlternativePrinterNames!
  isBambuSupported: Boolean!
  insertedAt: DateTime!
  updatedAt: DateTime!
  nozzleDiameter: Float!
  heatedBed: Boolean!
  heatedChamber: Boolean!
  maxExtruderFlowRate: Float!
  minExtruderFlowRate: Float!
  minHardwarePrintSpeed: Float!
  maxHardwarePrintSpeed: Float!
  chamberType: ChamberType!
  numberOfNozzles: Int!
  nNodes: Int!
  """Maximum hardware extrusion temperature (in Kelvin)"""
  maxHardwareExtrusionTemp: Float!
  """Minimum hardware extrusion temperature (in Kelvin)"""
  minHardwareExtrusionTemp: Float!
}

"""A multi-material G-code."""
type GcodeV3 {
  id: ID!
  name: String!
  status: GcodeStatus!
  progress: Float!
  sizeKb: Float
  height: Float
  width: Float
  depth: Float
  weight: Float
  platformTemperature: GcodeCustomFloat
  nozzleTemperatureMin: GcodeCustomFloat
  nozzleTemperatureMax: GcodeCustomFloat
  """Uploaded G-code object key. Use `gcodeUrl` for a download URL."""
  gcodeKey: String
  roadWidthMin: GcodeCustomFloat
  roadWidthMax: GcodeCustomFloat
  layerHeightMin: GcodeCustomFloat
  layerHeightMax: GcodeCustomFloat
  speedMin: GcodeCustomFloat
  speedMax: GcodeCustomFloat
  fanSpeedMin: GcodeCustomFloat
  fanSpeedMax: GcodeCustomFloat
  numberOfLayers: Int
  slicer: Slicer
  flowRatio: Float
  overrideGcodeParams: OverrideGcodeParams
  isSingleShell: Boolean!
  maxFlowRate: Float
  layerHeightMode: Float
  lineWidthMode: Float
  restrictions: [GcodeRestriction!]
  restrictionsV2: [GcodeRestrictionInfo!]!
  errors: [GcodeError!] @deprecated(reason: "Use errorsV2 instead.")
  errorsV2: [GcodeErrorV2!]
  materialId: ID!
  printerId: ID!
  """Materials associated with this G-code."""
  materials: [GcodeMaterialInfo!]!
  insertedAt: DateTime!
  updatedAt: DateTime!
  """One-hour download URL for the G-code file."""
  gcodeUrl: String!
  """
  The primary material for this G-code (resolved from materialId).
  For multi-material G-codes this is the first material in the materials list.
  """
  material: Material!
}

type OptimizationImprovementResult {
  improvement: OptimizationImprovement!
  description: String!
}

type Simulation {
  id: ID!
  name: String!
  progress: Float!
  status: SimulationStatus!
  meshUrl: SimulationAsset
  """Extra mesh asset URL. Access is granted only to select individuals."""
  meshExtraUrl: SimulationAsset
  reportJsonUrl: String
  thermalIndexGcodeUrl: String
  """
  Presigned GET URL for the overview image generated by dragon-postprocess.
  `None` while the postprocessor is still running or has not produced an image.
  """
  overviewImageUrl: String
  estimatedSimulationDurationSeconds: Float
  simulationSettings: SimulationSettings!
  thermalIndexStatistics: ThermalIndexStatistics!
  featureFlagsUsed: SimulationFeatureFlags!
  materialId: ID!
  printerId: ID!
  printInfo: PrintInfo
  speedFactor: Float
  suggestedFixes: [SuggestedFix!]!
  updatedAt: DateTime!
  insertedAt: DateTime!
  gcode: GcodeV2!
  material: Material!
  printer: Printer!
}

"""A single-material G-code."""
type GcodeV2 {
  id: ID!
  name: String!
  status: GcodeStatus!
  progress: Float!
  sizeKb: Float
  height: Float
  width: Float
  depth: Float
  weight: Float
  platformTemperature: GcodeCustomFloat
  nozzleTemperatureMin: GcodeCustomFloat
  nozzleTemperatureMax: GcodeCustomFloat
  """Uploaded G-code object key. Use `gcodeUrl` for a download URL."""
  gcodeKey: String
  roadWidthMin: GcodeCustomFloat
  roadWidthMax: GcodeCustomFloat
  layerHeightMin: GcodeCustomFloat
  layerHeightMax: GcodeCustomFloat
  speedMin: GcodeCustomFloat
  speedMax: GcodeCustomFloat
  fanSpeedMin: GcodeCustomFloat
  fanSpeedMax: GcodeCustomFloat
  numberOfLayers: Int
  slicer: Slicer
  flowRatio: Float
  overrideGcodeParams: OverrideGcodeParams
  isSingleShell: Boolean!
  maxFlowRate: Float
  layerHeightMode: Float
  lineWidthMode: Float
  restrictions: [GcodeRestriction!]
