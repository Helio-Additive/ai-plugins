}

"""A redeemable free trial code."""
type FreeTrialCode {
  id: ID!
  code: String!
  isUsed: Boolean!
  group: FreeTrialCodeGroup!
  user: User
  redeemedAt: DateTime
  insertedAt: DateTime!
  updatedAt: DateTime!
}

input StringFilter {
  equalTo: String
  notEqualTo: String
  caseSensitiveContains: String
  caseInsensitiveContains: String
  caseSensitiveStartsWith: String
  caseInsensitiveStartsWith: String
  caseSensitiveEndsWith: String
  caseInsensitiveEndsWith: String
  notCaseSensitiveContains: String
  notCaseInsensitiveContains: String
  notCaseSensitiveStartsWith: String
  notCaseInsensitiveStartsWith: String
  notCaseSensitiveEndsWith: String
  notCaseInsensitiveEndsWith: String
}

type ThermalIndexStatistics {
  thermalIndexCount: Int
  thermalIndexMean: Float
  thermalIndexStd: Float
  thermalIndexMin: Float
  thermalIndex25: Float
  thermalIndex50: Float
  thermalIndex75: Float
  thermalIndexMax: Float
}

"""
Overrides applied to the G-code.

Temperatures are in Celsius; lengths are in millimetres.
"""
type OverrideGcodeParams {
  overrideConstantNozzleTemperature: Float
  overrideConstantLayerHeight: Float
  overrideConstantRoadWidth: Float
  overrideConstantPlatformTemperature: Float
}

input SlicerMachineFilter {
  engine: SlicerEngine
  search: String
  vendor: String
  nozzleDiameterMm: Float
  forSlicerVersion: String
}

enum StoreExperimentPlanTab {
  PERSONAL
  BUSINESS
}

type LayerRange {
  fromLayer: Int!
  toLayer: Int!
}

input CreateUploadedFileInput {
  """Optional display name; defaults to the uploaded object's filename."""
  name: String
  inputType: SliceInputType!
  inputKey: String!
  inputVersionId: String
}

enum GcodeErrorCode {
  NOZZLE_TEMPERATURE_NOT_FOUND
  PLATFORM_TEMPERATURE_NOT_FOUND
  LAYER_HEIGHT_NOT_FOUND
  LINE_WIDTH_NOT_FOUND
  INVALID_GCODE
  INTERNAL_ERROR
  HAS_NEGATIVE_Z_COORDINATES
  HAS_NO_COMMANDS
  HAS_NO_LAYERS
  HAS_UNCERTAIN_ENCODING
  HAS_ZERO_SPEED
  HAS_MULTI_MATERIAL_PRINTING
  COMMAND_FORMAT_ERROR
  COMMENT_FORMAT_ERROR
  VALUE_ERROR
  MULTI_MATERIAL_UNABLE_TO_DETECT_MATERIAL_SWITCH
  NOZZLE_INDEX_MISMATCH
  SLOT_INDEX_MISMATCH
}

"""Category of a FAQ entry."""
enum FaqCategory {
  """Printer-related FAQ."""
  PRINTER
  """Material-related FAQ."""
  MATERIAL
  """G-code-related FAQ."""
  GCODE
  """Simulation-related FAQ."""
  SIMULATION
}

enum GcodeTimingStatus {
  PENDING
  SUCCEEDED
  FAILED
}

type Summary {
  simulationCount: Int!
  materialCount: Int!
  printerCount: Int!
}

"""Input for updating the authenticated user's feature flag settings."""
