type Query {
  """Generate a presigned S3 PUT URL for direct file uploads."""
  getPresignedUrl(fileName: String!): PresignedUrl!
  """Aggregate counts across simulations, materials, and printers."""
  summary: Summary!
  """
  Fetch all feedback records submitted for a simulation.
  
  Scoped to the authenticated user — only feedback they submitted is
  returned.  Returns an empty list when no feedback exists yet.
  """
  simulationFeedback(simulationId: ID!): [SimulationFeedback!]!
  """
  List simulations with pagination and filtering.
  
  Ported from Python `list_simulations`. Scopes results to the authenticated
  user and supports sorting, filtering, and pagination.
  """
  simulations(
    """The page number to retrieve (1-based index)."""
    page: Int
    """Page size (default: 20, max: 100)."""
    pageSize: Int
    """Field to sort the results by."""
    sortBy: SimulationField
    """Direction to sort the results (ascending or descending)."""
    sortDirection: SortDirection
    """List of filters to apply to the Simulation results."""
    filters: [SimulationFilter!]
    """Filter simulations by status."""
    statusFilter: SimulationStatusFilter
  ): PaginatedSimulations!
  """
  List optimizations with pagination and filtering.
  
  Ported from Python `list_optimizations`. Scopes results to the authenticated
  user and supports sorting, filtering, and pagination.
  """
  optimizations(
    """The page number to retrieve (1-based index)."""
    page: Int
    """Page size (default: 20, max: 100)."""
    pageSize: Int
    """Field to sort the results by."""
    sortBy: OptimizationField
    """Direction to sort the results (ascending or descending)."""
    sortDirection: SortDirection
    """List of filters to apply to the Optimization results."""
    filters: [OptimizationFilter!]
  ): PaginatedOptimizations!
  """
  Get a single simulation by ID.
  
  Ported from Python `get_simulation`. Verifies the simulation exists and
  that the requesting user owns it (matching Python's lack of global
  staff-bypass on this endpoint).
  """
  simulation(
    """The unique identifier of the Simulation to retrieve."""
    id: ID!
  ): Simulation!
  """
  Get a single optimization by ID.
  
  Ported from Python `get_optimization`.
  """
  optimization(
    """The unique identifier of the Optimization to retrieve."""
    id: ID!
  ): Optimization!
  """
  Get default simulation settings for a G-code.
  
  Ported from Python `get_simulation_defaults`. The full implementation
  requires fetching gcode/printer data from external services to calculate
  thermal parameters based on printer chamber type and heated bed config.
  
  TODO: Fetch G-code from gcodes service to get `printer_id` & `platform_temperature`.
  TODO: Fetch printer from printers service to get `chamber_type`, `is_heated_bed`, etc.
  TODO: Calculate `stabilized_air_temperature` from printer linear model or chamber type.
  """
  simulationDefaults(
    """
    The unique identifier of the G-Code for which to get default simulation settings.
    """
    gcodeId: ID!
    """Ambient room temperature (K, min: 0)."""
    roomTemperature: Float
    """Stabilized air temperature (K, min: 0)."""
    stabilizedTemperature: Float
    """Constant platform temperature (K, min: 0)."""
    constantPlatformTemperature: Float
  ): SimulationSettings!
  """
  Get default optimization settings for a G-code.
  
  Ported from the old production monolith's optimization default resolver.
  """
  optimizationDefaults(
    """
    The unique identifier of the G-Code for which to get default optimization settings.
    """
    gcodeId: ID!
  ): OptimizationSettings!
  """
  Get default optimization settings for a G-code (alias for `optimizationDefaults`).
  
  Exposed under the old API name so existing clients continue to work.
  """
  defaultOptimizationSettings(
    """
    The unique identifier of the G-Code for which to get default optimization settings.
    """
    gcodeId: ID!
  ): OptimizationSettings!
  """
  Get default simulation settings for a G-code (alias for `simulationDefaults`).
  
  Exposed under the old API name so existing clients continue to work.
  """
  defaultSimulationSettings(
    """
    The unique identifier of the G-Code for which to get default simulation settings.
    """
    gcodeId: ID!
    """Ambient room temperature (K, min: 0)."""
    roomTemperature: Float
    """Stabilized air temperature (K, min: 0)."""
    stabilizedTemperature: Float
    """Constant platform temperature (K, min: 0)."""
    constantPlatformTemperature: Float
  ): SimulationSettings!
  """
  Fetch a thermal history asset (staff only).
  
  Ported from Python `fetch_thermal_history_asset`. Returns a presigned URL
  to a parquet file containing thermal history data for a specific layer.
  
  TODO: Check `is_helio_staff` from context once auth provides it.
  """
  thermalHistoryAsset(optimizationId: ID!, layer: Int!, isOptimized: Boolean!): SimulationAsset
  """Alias for `thermalHistoryAsset` matching the old API query name."""
  thermalHistories(optimizationId: ID!, layer: Int!, isOptimized: Boolean!): SimulationAsset
  """
  List available print priority options.
  
  Ported from Python `list_print_priority_options`. Returns the options for the
  Print Priority selector dropdown. When a `material_id` is provided, the
  "Enhance Surface Gloss" option is only available if the material is glossy.
  "Enhance Transparency" option is only available if the material is transparent.
  Multimaterial requests always mark "Enhance Transparency" as unavailable.
  """
  printPriorityOptions(
    """Optional material ID to check compatibility."""
    materialId: ID
    """Whether the print uses multiple distinct materials. Defaults to false."""
    isMultiMaterial: Boolean
  ): [PrintPriorityOption!]!
  """
  List the authenticated user's G-codes with pagination, filtering, and sorting.
  """
  gcodesV2(page: Int, pageSize: Int, sortBy: GcodeField, sortDirection: SortDirection, filters: [GcodeFilter!]): PaginatedGcodes!
  """Fetch a G-code by ID. Deprecated; use `gcodeV2` instead."""
  gcode(id: ID!): Gcode! @deprecated(reason: "Use gcodeV2 instead.")
  """Fetch a G-code by ID."""
  gcodeV2(id: ID!): GcodeV2!
  """List the authenticated user's multi-material G-codes."""
  gcodesV3(page: Int! = 1, pageSize: Int, sortBy: GcodeField, sortDirection: SortDirection, filters: [GcodeFilter!]): PaginatedGcodesV3!
  """Fetch a multi-material G-code by ID."""
  gcodeV3(id: ID!): GcodeV3!
  """
  Retrieve a paginated list of FAQs, ordered newest-first.
  
  - `page` — 1-based page number
  - `page_size` — items per page, clamped to 1–100
  """
  faqs(page: Int = 1, pageSize: Int = 20): PaginatedFaqs!
  """Retrieve a single FAQ by ID."""
  faq(id: ID!): Faq!
  materials(page: Int, pageSize: Int, sortBy: MaterialField, sortDirection: SortDirection, filters: [MaterialFilter!]): PaginatedMaterials!
  material(id: ID!): Material!
  materialsSummary: MaterialSummary!
  """Retrieve a single news article by ID."""
  newsArticle(id: ID!): NewsArticle!
  """
  Retrieve a paginated list of news articles ordered by newest first.
  
  Excludes soft-deleted articles (`is_deleted = true`).
  """
  newsArticles(page: Int, pageSize: Int): PaginatedNewsArticles!
  """
  Get or create feedback for the current user on a news article.
  
  If no feedback row exists for (article_id, user_id), a blank one is
  inserted (all flags false) and then returned.
  """
  newsArticleFeedback(newsArticleId: ID!): NewsArticleFeedback!
  """Retrieve a paginated list of events ordered by newest first."""
  events(page: Int, pageSize: Int): PaginatedEvents!
  """
  Start or resume an authenticated Store visit and return its presentation decision.
  """
  storeExperimentDecision(surface: StoreExperimentSurface!, visitId: ID!): StoreExperimentDecision!
  """
  Return the country context that should be used for localized pricing
  previews.
  """
  pricingContext: PricingContext!
  """Retrieve a paginated list of active subscription plans."""
  subscriptions(page: Int, pageSize: Int): PaginatedSubscriptions!
  """Retrieve a paginated list of active subscription add-ons."""
  subscriptionAddOns(page: Int, pageSize: Int): PaginatedSubscriptionAddOns!
  """
  Retrieve the current user's free trial claim, or null if they have
  never claimed a free trial.
  """
  freeTrialClaim: FreeTrialClaim
  """
  Check whether the current user is eligible to claim a free trial.
  
  Returns `true` when the user has not previously claimed a free trial and
  their account history does not already disqualify them.
  """
  freeTrialEligibility: Boolean!
  printers(page: Int, pageSize: Int, sortBy: PrinterField, sortDirection: SortDirection, filters: [PrinterFilter!]): PaginatedPrinters!
  printer(id: ID!): Printer!
  printersSummary: PrinterSummary!
  """Retrieve a timing request belonging to the authenticated user."""
  getGcodeTiming(id: ID!): GcodeTiming!
  """
  List only the authenticated user's registered files. Pages are 1-based,
  clamped to 1..50; pageSize defaults to 20 and is clamped to 1..100.
  """
  uploadedFiles(page: Int, pageSize: Int, filter: UploadedFileFilter, sortBy: SlicingSortField, sortDirection: SlicingSortDirection): PaginatedUploadedFiles!
  """
  List only the authenticated user's slices. Pages are 1-based, clamped
  to 1..50; pageSize defaults to 20 and is clamped to 1..100.
  """
  slices(page: Int, pageSize: Int, filter: SliceFilter, sortBy: SlicingSortField, sortDirection: SlicingSortDirection): PaginatedSlices!
  getUploadedFile(id: ID!): UploadedFile!
  """Retrieve an input probe belonging to the authenticated user."""
  getInputProbe(id: ID!): InputProbe!
  """Retrieve a slice belonging to the authenticated user."""
  getSlice(id: ID!): Slice!
  """Return the slicer runner version supported by this service."""
  slicerVersion: String!
  """
  Schema-only validation; hardware-dependent constraints are checked when slicing.
  """
  validateSlicerSettings(engine: SlicerEngine!, settings: String!): SettingsValidation!
  """Return the compact BambuStudio settings JSON Schema encoded as base64."""
  bambuSettingsBase64JsonSchema: String!
  """Return the compact OrcaSlicer settings JSON Schema encoded as base64."""
  orcaSettingsBase64JsonSchema: String!
  """
  Return the compact Snapmaker Orca settings JSON Schema encoded as base64.
  """
  snapmakerSettingsBase64JsonSchema: String!
  """List packaged slicer machine profiles."""
  slicerMachines(filter: SlicerMachineFilter): [SlicerMachine!]!
  """List packaged slicer filament profiles."""
  slicerFilaments(filter: SlicerFilamentFilter): [SlicerFilament!]!
  """List packaged slicer process profiles."""
  slicerProcesses(filter: SlicerProcessFilter): [SlicerProcess!]!
  """Retrieve the currently authenticated user."""
  user: User!
  """
  Retrieve the personal access tokens belonging to the authenticated user.
  """
  personalAccessTokens: [PersonalAccessToken!]!
  """
  Retrieve the login history for the authenticated user, ordered most recent first.
  """
  logins: [Login!]!
  """
  Retrieve the system-wide default values for all user feature flags.
  
  These are the values that a newly created user receives before they
  have explicitly changed any flag.
  """
  featureFlagDefaults: FeatureFlagDefaults!
  """
  Retrieve a paginated list of billing transaction histories for the
  authenticated user.
  
  - `page` — 1-based page number (default: `1`)
  - `page_size` — records per page, capped at 100 (default: `10`)
  """
  transactionHistoriesForUser(page: Int, pageSize: Int): PaginatedTransactionHistories!
}

