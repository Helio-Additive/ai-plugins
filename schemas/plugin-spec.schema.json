{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin spec",
  "description": "Source configuration for one Helio Additive plugin. The build discovers plugins/*/spec.yaml and constructs provider documents from these values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "displayName",
    "shortDescription",
    "longDescription",
    "defaultPrompts"
  ],
  "properties": {
    "name": {
      "description": "Stable plugin and MCP server identifier.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "description": "Public company or product website. Mapped to portable/native homepage and OpenAI interface.websiteURL; separate from source and licence links in descriptions.",
      "type": "string",
      "pattern": "^https://",
      "maxLength": 1024
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "shortDescription": {
      "type": "string",
      "minLength": 1
    },
    "longDescription": {
      "type": "string",
      "minLength": 1
    },
    "defaultPrompts": {
      "description": "Suggested prompts mapped to extensions.com.openai.interface.defaultPrompt.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "testPath": {
      "description": "Predefined provider-neutral test route for this plugin, appended to MCP_TEST_URL. A single absolute path segment, without a provider prefix.",
      "type": "string",
      "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openai",
        "anthropic",
        "kimi-global",
        "kimi-china"
      ],
      "properties": {
        "openai": {
          "$ref": "#/definitions/connection"
        },
        "anthropic": {
          "$ref": "#/definitions/connection"
        },
        "kimi-global": {
          "$ref": "#/definitions/urlConnection"
        },
        "kimi-china": {
          "$ref": "#/definitions/urlConnection"
        }
      }
    },
    "openaiSubmission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "developerName": {
          "type": "string",
          "minLength": 1
        },
        "supportURL": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 1024
        },
        "privacyPolicyURL": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 1024
        },
        "termsOfServiceURL": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 1024
        },
        "releaseNotes": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "$ref": "#/definitions/reviewCases"
        },
        "introduction": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "developerName",
        "supportURL",
        "privacyPolicyURL",
        "termsOfServiceURL",
        "releaseNotes",
        "cases"
      ]
    }
  },
  "definitions": {
    "urlConnection": {
      "title": "MCP URL-only connection",
      "description": "Provider MCP endpoint for hosts whose plugin manifests cannot carry an OAuth client registration or scopes (Kimi Code CLI registers a public client dynamically and runs OAuth itself). Secrets must never be stored in a plugin spec.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "description": "Absolute HTTPS provider endpoint, without credentials or a fragment.",
          "type": "string",
          "pattern": "^https://",
          "minLength": 1
        }
      }
    },
    "connection": {
      "title": "MCP connection",
      "description": "Provider MCP endpoint and public OAuth registration. Secrets must never be stored in a plugin spec.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "clientId"
      ],
      "properties": {
        "url": {
          "description": "Absolute HTTPS provider endpoint, without credentials or a fragment.",
          "type": "string",
          "pattern": "^https://",
          "minLength": 1
        },
        "clientId": {
          "description": "Registered public OAuth client identifier, not a client secret.",
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "description": "Scopes always requested. Omit to preserve provider defaults.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\S+$"
          }
        },
        "tokenEndpointAuthMethod": {
          "type": "string",
          "enum": [
            "none"
          ],
          "description": "Explicit public-client authentication method when registered without a secret."
        }
      }
    },
    "reviewCases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "tools_triggered": {
                "type": "string",
                "minLength": 1
              },
              "expected_behavior": {
                "type": "string",
                "minLength": 1
              },
              "file_attachment_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            },
            "required": [
              "description",
              "prompt",
              "tools_triggered",
              "expected_behavior"
            ]
          }
        },
        "negative": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "description",
              "prompt"
            ]
          }
        }
      },
      "required": [
        "positive",
        "negative"
      ]
    }
  },
  "dependencies": {
    "mcp": [
      "testPath"
    ],
    "testPath": [
      "mcp"
    ]
  }
}
