{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin spec",
  "description": "Source configuration for one Helio Additive plugin. The build discovers plugins/*/spec.yaml and constructs provider documents from these values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "displayName",
    "shortDescription",
    "longDescription",
    "defaultPrompts",
    "mcp"
  ],
  "properties": {
    "name": {
      "description": "Stable plugin and MCP server identifier.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "shortDescription": {
      "type": "string",
      "minLength": 1
    },
    "longDescription": {
      "type": "string",
      "minLength": 1
    },
    "defaultPrompts": {
      "description": "Suggested prompts mapped to extensions.com.openai.interface.defaultPrompt.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openai", "anthropic"],
      "properties": {
        "openai": {
          "$ref": "#/definitions/connection"
        },
        "anthropic": {
          "$ref": "#/definitions/connection"
        }
      }
    }
  },
  "definitions": {
    "connection": {
      "title": "MCP connection",
      "description": "Provider MCP endpoint and public OAuth registration. Secrets must never be stored in a plugin spec.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "clientId"],
      "properties": {
        "url": {
          "description": "Absolute HTTPS provider endpoint, without credentials or a fragment.",
          "type": "string",
          "pattern": "^https://",
          "minLength": 1
        },
        "clientId": {
          "description": "Registered public OAuth client identifier, not a client secret.",
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "description": "Scopes always requested. Omit to preserve provider defaults.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\S+$"
          }
        }
      }
    }
  }
}
